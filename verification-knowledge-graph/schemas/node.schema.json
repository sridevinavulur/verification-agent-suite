{
  "$defs": {
    "NodeType": {
      "description": "Typed node kinds tracked by the graph (spec 6.12).",
      "enum": [
        "requirement",
        "module",
        "interface",
        "signal",
        "reset_domain",
        "assertion",
        "test",
        "coverage_bin",
        "regression",
        "failure",
        "waiver",
        "bug",
        "evidence_claim",
        "benchmark"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Where a node/edge came from.\n\n``artifact`` is the importer name (e.g. ``rtl_intent_manifest``).\n``source_file`` is the path of the imported JSON. ``locator`` is a\nbest-effort human-readable pointer (line number, key path, bin name)\ninto that source. ``input_hash`` is the sha256 of the source file so a\nrun can be reproduced and audited.",
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        }
      },
      "required": [
        "artifact"
      ],
      "title": "SourceProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A typed graph node with a stable ID and provenance.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/NodeType"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "attrs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Attrs",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/SourceProvenance"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "provenance"
  ],
  "title": "Node",
  "type": "object"
}
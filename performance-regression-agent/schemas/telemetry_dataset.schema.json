{
  "$defs": {
    "Environment": {
      "additionalProperties": false,
      "description": "Hardware and tool-version context for a set of measurements.",
      "properties": {
        "platform": {
          "description": "e.g. 'x86_64-linux', 'fpga-u250'",
          "title": "Platform",
          "type": "string"
        },
        "cpu_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Model"
        },
        "ram_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Gb"
        },
        "tool": {
          "description": "e.g. 'verilator', 'jaspergold', 'vivado'",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "description": "e.g. '5.020'",
          "title": "Tool Version",
          "type": "string"
        },
        "os_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os Release"
        }
      },
      "required": [
        "platform",
        "tool",
        "tool_version"
      ],
      "title": "Environment",
      "type": "object"
    },
    "MetricName": {
      "description": "Canonical performance metric identifiers.\n\nKept as (str, Enum) for stable, human-readable JSON serialization.",
      "enum": [
        "sim_runtime_s",
        "formal_runtime_s",
        "peak_memory_mb",
        "throughput_mops",
        "latency_ns",
        "bandwidth_gbps",
        "utilization_pct",
        "coverage_rate_pct",
        "fpga_fmax_mhz",
        "fpga_lut_util_pct"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricSample": {
      "additionalProperties": false,
      "description": "A single measured value for one metric within a run.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/MetricName"
        },
        "value": {
          "description": "Measured value in the metric's canonical unit",
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value"
      ],
      "title": "MetricSample",
      "type": "object"
    },
    "TelemetryRun": {
      "additionalProperties": false,
      "description": "One execution of a workload on a commit/config, with repeated samples.\n\n``samples`` holds one-or-more repetitions per metric so variance and\nconfidence can be computed. A run is scoped to a (commit, config,\nworkload, environment) tuple.",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "commit": {
          "description": "Git SHA (placeholder allowed)",
          "title": "Commit",
          "type": "string"
        },
        "commit_order": {
          "description": "Monotonic index; higher = newer",
          "minimum": 0,
          "title": "Commit Order",
          "type": "integer"
        },
        "config": {
          "description": "Build/experiment configuration name",
          "title": "Config",
          "type": "string"
        },
        "workload": {
          "description": "Workload / trace name",
          "title": "Workload",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "artifact_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Link to raw logs/waveforms/reports",
          "title": "Artifact Url"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/MetricSample"
          },
          "minItems": 1,
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "commit",
        "commit_order",
        "config",
        "workload",
        "environment",
        "samples"
      ],
      "title": "TelemetryRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A collection of telemetry runs forming the analysis input.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/TelemetryRun"
      },
      "minItems": 1,
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "name",
    "runs"
  ],
  "title": "TelemetryDataset",
  "type": "object"
}

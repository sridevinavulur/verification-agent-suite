{
  "$defs": {
    "AccessType": {
      "description": "Closed set of supported field/register access semantics.\n\nThe tool refuses to invent semantics; any source token that does not map\nonto one of these members is reported as an ``UNKNOWN_ACCESS`` discrepancy.",
      "enum": [
        "RO",
        "RW",
        "WO",
        "W1C",
        "W1S",
        "RC",
        "RESERVED"
      ],
      "title": "AccessType",
      "type": "string"
    },
    "CandidateSVA": {
      "additionalProperties": false,
      "description": "A candidate assertion. Always ``candidate`` \u2014 never proven/verified.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "register": {
          "default": "",
          "title": "Register",
          "type": "string"
        },
        "field": {
          "default": "",
          "title": "Field",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "sva": {
          "title": "Sva",
          "type": "string"
        },
        "status": {
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "name",
        "check",
        "sva"
      ],
      "title": "CandidateSVA",
      "type": "object"
    },
    "CoverageRow": {
      "additionalProperties": false,
      "properties": {
        "register": {
          "title": "Register",
          "type": "string"
        },
        "field": {
          "default": "",
          "title": "Field",
          "type": "string"
        },
        "access": {
          "default": "",
          "title": "Access",
          "type": "string"
        },
        "checks_covered": {
          "items": {
            "type": "string"
          },
          "title": "Checks Covered",
          "type": "array"
        },
        "sva_count": {
          "default": 0,
          "title": "Sva Count",
          "type": "integer"
        },
        "test_count": {
          "default": 0,
          "title": "Test Count",
          "type": "integer"
        }
      },
      "required": [
        "register"
      ],
      "title": "CoverageRow",
      "type": "object"
    },
    "DirectedTest": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "register": {
          "default": "",
          "title": "Register",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "expected": {
          "default": "",
          "title": "Expected",
          "type": "string"
        }
      },
      "required": [
        "name",
        "check"
      ],
      "title": "DirectedTest",
      "type": "object"
    },
    "Discrepancy": {
      "additionalProperties": false,
      "description": "A deterministic finding. Never a PASS; always something to review/fix.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "register": {
          "default": "",
          "title": "Register",
          "type": "string"
        },
        "field": {
          "default": "",
          "title": "Field",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Discrepancy",
      "type": "object"
    },
    "Field_": {
      "additionalProperties": false,
      "description": "A named bit field inside a register.\n\n``bit_offset``/``bit_width`` are the normalized bit range. Source formats\nthat give ``[msb:lsb]`` are converted to offset/width by the parser.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bit_offset": {
          "minimum": 0,
          "title": "Bit Offset",
          "type": "integer"
        },
        "bit_width": {
          "minimum": 1,
          "title": "Bit Width",
          "type": "integer"
        },
        "access": {
          "$ref": "#/$defs/AccessType"
        },
        "reset_value": {
          "minimum": 0,
          "title": "Reset Value",
          "type": "integer"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "side_effect": {
          "default": "",
          "title": "Side Effect",
          "type": "string"
        },
        "interrupt_related": {
          "default": false,
          "title": "Interrupt Related",
          "type": "boolean"
        },
        "privilege": {
          "$ref": "#/$defs/Privilege",
          "default": "ANY"
        }
      },
      "required": [
        "name",
        "bit_offset",
        "bit_width",
        "access",
        "reset_value"
      ],
      "title": "Field_",
      "type": "object"
    },
    "GroundingReport": {
      "additionalProperties": false,
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/GroundingResult"
          },
          "title": "Results",
          "type": "array"
        },
        "matched_count": {
          "default": 0,
          "title": "Matched Count",
          "type": "integer"
        },
        "total_count": {
          "default": 0,
          "title": "Total Count",
          "type": "integer"
        },
        "unmatched_manifest": {
          "items": {
            "type": "string"
          },
          "title": "Unmatched Manifest",
          "type": "array"
        },
        "unmatched_rtl": {
          "items": {
            "type": "string"
          },
          "title": "Unmatched Rtl",
          "type": "array"
        }
      },
      "title": "GroundingReport",
      "type": "object"
    },
    "GroundingResult": {
      "additionalProperties": false,
      "description": "Result of mapping one manifest register/field onto an RTL symbol.",
      "properties": {
        "manifest_name": {
          "title": "Manifest Name",
          "type": "string"
        },
        "rtl_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rtl Symbol"
        },
        "matched": {
          "default": false,
          "title": "Matched",
          "type": "boolean"
        },
        "match_kind": {
          "default": "none",
          "title": "Match Kind",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "manifest_name"
      ],
      "title": "GroundingResult",
      "type": "object"
    },
    "Privilege": {
      "description": "Optional access-privilege annotation for security-sensitive registers.",
      "enum": [
        "USER",
        "SUPERVISOR",
        "MACHINE",
        "SECURE",
        "ANY"
      ],
      "title": "Privilege",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "default": "register-csr-agent",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "0.1.0",
          "title": "Tool Version",
          "type": "string"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "command": {
          "default": "",
          "title": "Command",
          "type": "string"
        },
        "git_sha": {
          "default": "UNKNOWN",
          "title": "Git Sha",
          "type": "string"
        },
        "input_files": {
          "items": {
            "type": "string"
          },
          "title": "Input Files",
          "type": "array"
        },
        "input_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Sha256",
          "type": "object"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Register": {
      "additionalProperties": false,
      "description": "A single addressable register.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "address": {
          "minimum": 0,
          "title": "Address",
          "type": "integer"
        },
        "width_bits": {
          "minimum": 1,
          "title": "Width Bits",
          "type": "integer"
        },
        "access": {
          "$ref": "#/$defs/AccessType",
          "default": "RW"
        },
        "reset_value": {
          "minimum": 0,
          "title": "Reset Value",
          "type": "integer"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field_"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "name",
        "address",
        "width_bits",
        "reset_value"
      ],
      "title": "Register",
      "type": "object"
    },
    "RegisterMap": {
      "additionalProperties": false,
      "description": "Normalized register manifest (the tool's canonical intermediate form).",
      "properties": {
        "name": {
          "default": "csr_block",
          "title": "Name",
          "type": "string"
        },
        "data_width_bits": {
          "default": 32,
          "minimum": 1,
          "title": "Data Width Bits",
          "type": "integer"
        },
        "address_unit_bytes": {
          "default": 1,
          "minimum": 1,
          "title": "Address Unit Bytes",
          "type": "integer"
        },
        "registers": {
          "items": {
            "$ref": "#/$defs/Register"
          },
          "title": "Registers",
          "type": "array"
        },
        "source_format": {
          "default": "unknown",
          "title": "Source Format",
          "type": "string"
        },
        "source_file": {
          "default": "",
          "title": "Source File",
          "type": "string"
        }
      },
      "title": "RegisterMap",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "prompt",
        "why"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "ERROR",
        "WARNING",
        "INFO"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Top-level reviewable output artifact.",
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "register_map": {
      "$ref": "#/$defs/RegisterMap"
    },
    "grounding": {
      "$ref": "#/$defs/GroundingReport"
    },
    "discrepancies": {
      "items": {
        "$ref": "#/$defs/Discrepancy"
      },
      "title": "Discrepancies",
      "type": "array"
    },
    "candidate_sva": {
      "items": {
        "$ref": "#/$defs/CandidateSVA"
      },
      "title": "Candidate Sva",
      "type": "array"
    },
    "directed_tests": {
      "items": {
        "$ref": "#/$defs/DirectedTest"
      },
      "title": "Directed Tests",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageRow"
      },
      "title": "Coverage",
      "type": "array"
    },
    "review_checklist": {
      "items": {
        "$ref": "#/$defs/ReviewItem"
      },
      "title": "Review Checklist",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "register_map",
    "grounding"
  ],
  "title": "VerificationPackage",
  "type": "object"
}

{
  "$defs": {
    "PropertySignal": {
      "additionalProperties": false,
      "description": "One signal referenced by a property (the COI seed set).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "asserted",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PropertySignal",
      "type": "object"
    },
    "PropertySpec": {
      "additionalProperties": false,
      "description": "A property and the signal set that seeds the cone-of-influence walk.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/PropertySignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "PropertySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PropertySpec"
      },
      "title": "Properties"
    }
  },
  "title": "PropertySet",
  "type": "object"
}

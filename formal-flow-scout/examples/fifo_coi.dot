digraph coi {
  rankdir=RL;  // fan-in points right-to-left
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  label="COI: no_overflow  (top=fifo_ctrl)";
  n0 [label="fifo_ctrl.clk", shape=diamond, style=filled, fillcolor=khaki, color=black, penwidth=1];
  n1 [label="fifo_ctrl.rst_n", shape=diamond, style=filled, fillcolor=salmon, color=black, penwidth=1];
  n2 [label="fifo_ctrl.push", shape=invhouse, style=filled, fillcolor=palegreen, color=red, penwidth=3];
  n3 [label="fifo_ctrl.pop", shape=invhouse, style=filled, fillcolor=palegreen, color=black, penwidth=1];
  n4 [label="fifo_ctrl.full", shape=house, style=filled, fillcolor=palegreen, color=red, penwidth=3];
  n5 [label="fifo_ctrl.empty", shape=house, style=filled, fillcolor=palegreen, color=black, penwidth=1];
  n9 [label="fifo_ctrl.occ", shape=box, style=filled, fillcolor=lightblue, color=red, penwidth=3];
  n10 [label="fifo_ctrl.do_push", shape=ellipse, style=filled, fillcolor=white, color=black, penwidth=1];
  n11 [label="fifo_ctrl.do_pop", shape=ellipse, style=filled, fillcolor=white, color=black, penwidth=1];
  n4 -> n9 [style=solid, color=black, label="comb"];
  n5 -> n9 [style=solid, color=black, label="comb"];
  n9 -> n0 [style=dashed, color=goldenrod, label="clock"];
  n9 -> n1 [style=dashed, color=red, label="reset"];
  n9 -> n9 [style=bold, color=blue, label="seq"];
  n9 -> n10 [style=bold, color=blue, label="seq"];
  n9 -> n11 [style=bold, color=blue, label="seq"];
  n10 -> n2 [style=solid, color=black, label="comb"];
  n10 -> n4 [style=solid, color=black, label="comb"];
  n11 -> n3 [style=solid, color=black, label="comb"];
  n11 -> n5 [style=solid, color=black, label="comb"];
}

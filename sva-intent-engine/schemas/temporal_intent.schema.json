{
  "$defs": {
    "ImplicationStyle": {
      "description": "Overlapping (|->) vs non-overlapping (|=>) implication.",
      "enum": [
        "overlapping",
        "non_overlapping"
      ],
      "title": "ImplicationStyle",
      "type": "string"
    },
    "PropertyForm": {
      "description": "Renderable candidate property forms (spec 5.6).",
      "enum": [
        "invariant",
        "implication",
        "bounded_response",
        "next_cycle",
        "no_overflow",
        "no_underflow",
        "one_hot",
        "stable_while_stalled",
        "reset_state",
        "eventually_within_bound"
      ],
      "title": "PropertyForm",
      "type": "string"
    },
    "PropertyKind": {
      "description": "SVA property directive.",
      "enum": [
        "assert",
        "assume",
        "cover"
      ],
      "title": "PropertyKind",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Immutable-ish record of how an artifact was produced.",
      "properties": {
        "tool": {
          "default": "sva-intent-engine",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "0.1.0",
          "title": "Tool Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "git_sha": {
          "default": "UNKNOWN",
          "title": "Git Sha",
          "type": "string"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "model_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ResetPolarity": {
      "enum": [
        "active_high",
        "active_low",
        "unknown"
      ],
      "title": "ResetPolarity",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SymbolRef": {
      "additionalProperties": false,
      "description": "A grounded symbol reference with source evidence.",
      "properties": {
        "symbol_id": {
          "title": "Symbol Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "symbol_id",
        "name"
      ],
      "title": "SymbolRef",
      "type": "object"
    },
    "TemporalStrength": {
      "enum": [
        "strong",
        "weak"
      ],
      "title": "TemporalStrength",
      "type": "string"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "check",
        "passed"
      ],
      "title": "ValidationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Typed temporal-intent intermediate representation (spec 5.3).\n\nThis is the deterministic contract handed to the renderer. It carries an\nexplicit clock (or the renderer rejects it), explicit bounds, and the exact\ngrounded symbols used.",
  "properties": {
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "clause_id": {
      "title": "Clause Id",
      "type": "string"
    },
    "source_text": {
      "title": "Source Text",
      "type": "string"
    },
    "design_top": {
      "title": "Design Top",
      "type": "string"
    },
    "property_kind": {
      "$ref": "#/$defs/PropertyKind"
    },
    "property_form": {
      "$ref": "#/$defs/PropertyForm"
    },
    "render_template_id": {
      "title": "Render Template Id",
      "type": "string"
    },
    "clock_signal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clock Signal"
    },
    "reset_signal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reset Signal"
    },
    "reset_polarity": {
      "$ref": "#/$defs/ResetPolarity",
      "default": "unknown"
    },
    "disable_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disable Condition"
    },
    "antecedent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Antecedent"
    },
    "consequent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consequent"
    },
    "implication_style": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImplicationStyle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "min_delay": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Delay"
    },
    "max_delay": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Delay"
    },
    "temporal_strength": {
      "$ref": "#/$defs/TemporalStrength",
      "default": "weak"
    },
    "environmental_assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Environmental Assumptions",
      "type": "array"
    },
    "referenced_symbols": {
      "items": {
        "$ref": "#/$defs/SymbolRef"
      },
      "title": "Referenced Symbols",
      "type": "array"
    },
    "ambiguities": {
      "items": {
        "type": "string"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "reviewer_status": {
      "default": "unreviewed",
      "title": "Reviewer Status",
      "type": "string"
    },
    "validation_checks": {
      "items": {
        "$ref": "#/$defs/ValidationCheck"
      },
      "title": "Validation Checks",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "requirement_id",
    "clause_id",
    "source_text",
    "design_top",
    "property_kind",
    "property_form",
    "render_template_id",
    "confidence",
    "provenance"
  ],
  "title": "TemporalIntent",
  "type": "object"
}

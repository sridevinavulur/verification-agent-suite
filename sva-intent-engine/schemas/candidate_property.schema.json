{
  "$defs": {
    "PropertyForm": {
      "description": "Renderable candidate property forms (spec 5.6).",
      "enum": [
        "invariant",
        "implication",
        "bounded_response",
        "next_cycle",
        "no_overflow",
        "no_underflow",
        "one_hot",
        "stable_while_stalled",
        "reset_state",
        "eventually_within_bound"
      ],
      "title": "PropertyForm",
      "type": "string"
    },
    "PropertyKind": {
      "description": "SVA property directive.",
      "enum": [
        "assert",
        "assume",
        "cover"
      ],
      "title": "PropertyKind",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Immutable-ish record of how an artifact was produced.",
      "properties": {
        "tool": {
          "default": "sva-intent-engine",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "0.1.0",
          "title": "Tool Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "git_sha": {
          "default": "UNKNOWN",
          "title": "Git Sha",
          "type": "string"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "model_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "stage"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SymbolRef": {
      "additionalProperties": false,
      "description": "A grounded symbol reference with source evidence.",
      "properties": {
        "symbol_id": {
          "title": "Symbol Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "symbol_id",
        "name"
      ],
      "title": "SymbolRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A rendered SVA property. 'Rendered' != 'verified'.",
  "properties": {
    "property_name": {
      "title": "Property Name",
      "type": "string"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "clause_id": {
      "title": "Clause Id",
      "type": "string"
    },
    "property_kind": {
      "$ref": "#/$defs/PropertyKind"
    },
    "property_form": {
      "$ref": "#/$defs/PropertyForm"
    },
    "sva_text": {
      "title": "Sva Text",
      "type": "string"
    },
    "referenced_symbols": {
      "items": {
        "$ref": "#/$defs/SymbolRef"
      },
      "title": "Referenced Symbols",
      "type": "array"
    },
    "ambiguities": {
      "items": {
        "type": "string"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "status": {
      "default": "candidate_compiled_offline",
      "title": "Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "property_name",
    "requirement_id",
    "clause_id",
    "property_kind",
    "property_form",
    "sva_text",
    "provenance"
  ],
  "title": "CandidateProperty",
  "type": "object"
}

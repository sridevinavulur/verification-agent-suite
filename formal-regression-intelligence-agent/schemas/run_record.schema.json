{
  "$defs": {
    "RunStatus": {
      "description": "Formal result vocabulary. See BUILD_STANDARD.md.\n\nOnly ``PASS`` denotes a proven/passing outcome. TIMEOUT / ERROR /\nINCONCLUSIVE are *never* success and are handled explicitly everywhere.\nA TIMEOUT is never treated as a PASS anywhere in this codebase.",
      "enum": [
        "PASS",
        "FAIL",
        "TIMEOUT",
        "ERROR",
        "INCONCLUSIVE"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "description": "One formal-run provenance row, as produced by ``formal-run-orchestrator``.\n\nOnly the fields this agent actually reads are declared; extra fields on the\ningested JSON are ignored so newer producers do not break ingestion. Field\nnames and semantics are copied from the orchestrator's ``RunRecord``.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Id"
    },
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "design_sha": {
      "title": "Design Sha",
      "type": "string"
    },
    "property_sha": {
      "title": "Property Sha",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "config_id": {
      "title": "Config Id",
      "type": "string"
    },
    "catalog_version": {
      "title": "Catalog Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "start_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Time"
    },
    "end_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Time"
    },
    "cpu_time_s": {
      "minimum": 0.0,
      "title": "Cpu Time S",
      "type": "number"
    },
    "wall_time_s": {
      "minimum": 0.0,
      "title": "Wall Time S",
      "type": "number"
    },
    "peak_memory_mb": {
      "minimum": 0.0,
      "title": "Peak Memory Mb",
      "type": "number"
    },
    "return_code": {
      "title": "Return Code",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    }
  },
  "required": [
    "run_id",
    "benchmark_id",
    "design_sha",
    "property_sha",
    "input_hash",
    "tool_name",
    "tool_version",
    "config_id",
    "catalog_version",
    "seed",
    "cpu_time_s",
    "wall_time_s",
    "peak_memory_mb",
    "return_code",
    "status"
  ],
  "title": "RunRecord",
  "type": "object"
}

{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "One evidence-backed regression-intelligence observation.\n\nA Finding is HEURISTIC: it reports a statistical/structural pattern, never a\nproven root cause. ``evidence`` holds the machine-readable substantiation and\n``member_run_ids`` lists the exact records the finding was computed from, so\nevery claim is reproducible and auditable.",
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "description": "Deterministic, template-generated description.",
          "title": "Summary",
          "type": "string"
        },
        "heuristic": {
          "default": true,
          "title": "Heuristic",
          "type": "boolean"
        },
        "member_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Member Run Ids",
          "type": "array"
        },
        "benchmark_ids": {
          "items": {
            "type": "string"
          },
          "title": "Benchmark Ids",
          "type": "array"
        },
        "config_ids": {
          "items": {
            "type": "string"
          },
          "title": "Config Ids",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": true,
          "description": "Machine-readable substantiation.",
          "title": "Evidence",
          "type": "object"
        },
        "priority_score": {
          "default": 0.0,
          "description": "Deterministic ranking score (higher first).",
          "title": "Priority Score",
          "type": "number"
        }
      },
      "required": [
        "finding_id",
        "kind",
        "severity",
        "title",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingKind": {
      "description": "The category of a regression-intelligence finding.",
      "enum": [
        "failure_cluster",
        "timeout_cluster",
        "duplicate_jobs",
        "runtime_regression",
        "memory_regression",
        "config_sensitivity",
        "reproducibility_warning"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "InvestigationItem": {
      "additionalProperties": false,
      "description": "One entry in the prioritized investigation queue.",
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "priority_score": {
          "title": "Priority Score",
          "type": "number"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "recommended_next_step": {
          "title": "Recommended Next Step",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "finding_id",
        "kind",
        "severity",
        "priority_score",
        "title",
        "recommended_next_step"
      ],
      "title": "InvestigationItem",
      "type": "object"
    },
    "Severity": {
      "description": "Triage severity for a finding. Ordered low -> high.",
      "enum": [
        "info",
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete analysis output for one ledger.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "n_records": {
      "title": "N Records",
      "type": "integer"
    },
    "n_jobs": {
      "description": "Distinct (benchmark, config) logical jobs.",
      "title": "N Jobs",
      "type": "integer"
    },
    "n_benchmarks": {
      "title": "N Benchmarks",
      "type": "integer"
    },
    "status_totals": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Status Totals",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "investigation_queue": {
      "items": {
        "$ref": "#/$defs/InvestigationItem"
      },
      "title": "Investigation Queue",
      "type": "array"
    }
  },
  "required": [
    "n_records",
    "n_jobs",
    "n_benchmarks",
    "status_totals",
    "findings",
    "investigation_queue"
  ],
  "title": "RegressionReport",
  "type": "object"
}

{
  "$defs": {
    "MachineMetadata": {
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "title": "Hostname",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "cpu_count": {
          "title": "Cpu Count",
          "type": "integer"
        }
      },
      "required": [
        "hostname",
        "platform",
        "python_version",
        "cpu_count"
      ],
      "title": "MachineMetadata",
      "type": "object"
    },
    "RunStatus": {
      "description": "Formal result vocabulary. See BUILD_STANDARD.md.\n\nOnly ``PASS`` denotes a proven/passing outcome. TIMEOUT / ERROR /\nINCONCLUSIVE are *never* success and are handled explicitly everywhere.",
      "enum": [
        "PASS",
        "FAIL",
        "TIMEOUT",
        "ERROR",
        "INCONCLUSIVE"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ValidationStatus": {
      "description": "Whether the orchestrator's own record-keeping/config choice is internally valid.\n\nThis is distinct from the *formal* result. A run may be VALID (well-formed,\nconfig in catalog, provenance complete) and still FAIL/TIMEOUT.",
      "enum": [
        "valid",
        "invalid_config",
        "incomplete_provenance"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable-by-convention provenance record for one execution.\n\nContains everything BUILD_STANDARD.md / spec 3.3 require: design & property\nSHAs, input hashes, tool name+version, command line, config ID, seed,\nmachine/OS metadata, start/end, CPU/wall time, peak memory, return code,\nstatus, artifact paths/hashes, rationale, validation status.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "design_sha": {
      "title": "Design Sha",
      "type": "string"
    },
    "property_sha": {
      "title": "Property Sha",
      "type": "string"
    },
    "input_hash": {
      "description": "Hash over (design_sha, property_sha, config).",
      "title": "Input Hash",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "config_id": {
      "title": "Config Id",
      "type": "string"
    },
    "catalog_version": {
      "title": "Catalog Version",
      "type": "string"
    },
    "command_line": {
      "title": "Command Line",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "machine": {
      "$ref": "#/$defs/MachineMetadata"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "cpu_time_s": {
      "minimum": 0.0,
      "title": "Cpu Time S",
      "type": "number"
    },
    "wall_time_s": {
      "minimum": 0.0,
      "title": "Wall Time S",
      "type": "number"
    },
    "peak_memory_mb": {
      "minimum": 0.0,
      "title": "Peak Memory Mb",
      "type": "number"
    },
    "return_code": {
      "title": "Return Code",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Path"
    },
    "artifact_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Hash"
    }
  },
  "required": [
    "run_id",
    "plan_id",
    "benchmark_id",
    "design_sha",
    "property_sha",
    "input_hash",
    "tool_name",
    "tool_version",
    "config_id",
    "catalog_version",
    "command_line",
    "seed",
    "machine",
    "start_time",
    "end_time",
    "cpu_time_s",
    "wall_time_s",
    "peak_memory_mb",
    "return_code",
    "status",
    "validation_status",
    "rationale"
  ],
  "title": "RunRecord",
  "type": "object"
}